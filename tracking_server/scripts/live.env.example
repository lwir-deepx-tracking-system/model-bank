# Board-specific settings of the live server. Copy to scripts/live.env (not tracked by git) and uncomment only what differs on your board.
# Read by scripts/run_real_gui.sh and scripts/keepalive.sh. Plain shell assignments, no spaces around "=".

# Address the web page listens on. Default: the board's Tailscale IPv4 address (interface tailscale0).
# The page has no password and moves the gimbal: give an address that only trusted devices can reach. 0.0.0.0 = every interface.
#LWIR_LIVE_BIND=<address of this board>

# Port of the web page (default 8090).
#LWIR_LIVE_PORT=8090

# Address of the team PC GUI (default 192.168.50.1). Video H.264/RTP to UDP 5000, track boxes to UDP 5001, the PC's commands on TCP 5002.
#LWIR_GUI_HOST=192.168.50.1

# Serial device of the gimbal (default /dev/ttyUSB0).
#LWIR_GIMBAL_DEV=/dev/ttyUSB0

# 자동으로 따라갈 때의 짐벌 최고 속도 (기본 100 = 장치 한계. 2026-11-10 까지는 10 이었다). 제어 값(PD)은 10 일 때 맞춘 것이다.
#LWIR_GIMBAL_SPEED_MAX=100

# 사람을 놓친 뒤 짐벌이 다시 잡기를 기다리는 시간, ms (기본 10000 = 10 초).
#LWIR_GIMBAL_REACQUIRE_MS=10000
