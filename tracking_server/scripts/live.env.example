# Board-specific settings of the live server. Copy to scripts/live.env (not tracked by git) and uncomment only what differs on your board.
# Read by scripts/run_real_gui.sh and scripts/keepalive.sh. Plain shell assignments, no spaces around "=".

# Address the web page listens on. Default: the board's Tailscale IPv4 address (interface tailscale0).
# The page has no password and moves the gimbal: give an address that only trusted devices can reach. 0.0.0.0 = every interface.
#LWIR_LIVE_BIND=<address of this board>

# Port of the web page (default 8090).
#LWIR_LIVE_PORT=8090

# Address of the team PC GUI (default 192.168.50.1). Video H.264/RTP to UDP 5000, track boxes to UDP 5001, the PC's commands on TCP 5002.
#LWIR_GUI_HOST=192.168.50.1

# Serial device of the gimbal (default /dev/ttyUSB0).
#LWIR_GIMBAL_DEV=/dev/ttyUSB0

# 자동으로 따라갈 때의 짐벌 최고 속도 (기본 100 = 장치 한계. 2026-11-10 까지는 10 이었다). 제어 값(PD)은 10 일 때 맞춘 것이다.
#LWIR_GIMBAL_SPEED_MAX=100

# 사람을 놓친 뒤 짐벌이 다시 잡기를 기다리는 시간, ms (기본 10000 = 10 초).
#LWIR_GIMBAL_REACQUIRE_MS=10000

# 새 사람을 화면에 내기 전에 확인하는 시간, ms (기본 130). 장 수 = round(130 x 잰 초당 장 수 / 1000), 3 장보다 작아지지 않는다:
# 초당 22~27 장이면 3 장(전과 같음), 초당 28 장을 넘으면 4 장. 0 = 끔 (전처럼 늘 3 장).
#LWIR_CONFIRM_MS=130

# 짐벌 프로그램 고르기 (기본 src/gimbal/gimbal_bridge_v25). v27 = 움직임 부드럽게 하는 시험용 판, 먼저 src/gimbal/V27_CHANGES.md 의 명령으로 빌드해야 한다.
#LWIR_GIMBAL_BRIDGE=src/gimbal/gimbal_bridge_v27
# 짐벌 프로그램에 더 줄 옵션 (v27 예).
#LWIR_GIMBAL_EXTRA_OPTS="--deadband-exit 0.10 --axis-reversal 1"

# 사람 상자의 어느 높이를 화면 가운데에 둘지 (기본 0.08 = 머리, 0.3 = 가슴, 0.5 = 상자 가운데). 바꾸면 화면의 세로 오차 표시 기준(page/js/04_ping_fps_aim.js 의 AIM_Y)도 같이 바꾼다.
#LWIR_GIMBAL_AIM_Y=0.08

# 녹화 재생 (2026-11-12). 웹 화면의 "녹화 재생" 구역이 이 폴더 아래의 녹화(<폴더>/<이름>/images/000001.png ...)를 카메라 대신 서버에 넣는다.
# 기본 /mnt/lwir_data/label_web/LWIR_labels (라벨 사이트의 폴더). 폴더가 없으면 재생은 꺼진다 (화면에 "쓸 수 없음"). 재생 중에는 짐벌이 움직이지 않는다.
#LWIR_REPLAY_ROOT=/mnt/lwir_data/label_web/LWIR_labels

# ---- 카메라 길 (2026-11-11) ----
# 아래 세 변수는 실행 스크립트가 아니라 서버(src/camera/camera_extra.py)와 카메라 프로그램(cam_pipe)이 직접 읽는다.
# 그래서 반드시 앞에 export 를 붙여 쓴다 (export 가 없으면 서버까지 전달되지 않아 아무 일도 일어나지 않는다).
# 바꾼 뒤에는 서버를 다시 시작해야 한다. 시간표·공유 메모리를 쓰려면 먼저 scripts/setup.sh 로 cam_pipe 를 다시 빌드한다 (v2.6).

# 카메라 기록 파일. 따로 켜지 않아도 켜져 있다: tracking_server/camera_events.log 에 카메라 프로그램의 줄(멈춤, 초기화, 셔터 등.
# 1초마다 나오는 속도 줄은 뺌)과 서버의 카메라 줄(LIVE camera, CAMRESET)을 날짜·시각과 함께 이어 쓴다. 서버를 다시 시작해도 지워지지 않는다.
# 4 MB 가 넘으면 camera_events.log.1 .2 .3 으로 밀린다 (합쳐서 16 MB 까지). 0 = 끄기, 파일 경로 = 그 파일에 쓰기.
#export LWIR_CAM_LOG=0

# 프레임 시간표 (기본 꺼짐). 1 로 하면 cam_pipe 가 프레임마다 48 바이트 머리(프레임 번호, 카메라에서 받은 시각, 앞 프레임과의 간격)를 붙이고,
# 서버가 프레임이 얼마나 오래된 것인지와 프레임 사이 간격을 잰다. 60초마다 한 줄 요약(STAMP 60 s)이 camera_events.log 에 남는다.
# 정확히 1 일 때만 켜진다 (그 밖의 값, 빈 값, 줄을 지움 = 꺼짐). cam_pipe 가 옛 것이라 머리가 안 오면 서버가 스스로 끄고 전 방식으로 다시 시작한다 (기록에 남음).
#export LWIR_CAM_STAMP=1

# 공유 메모리로 프레임 넘기기 (기본 꺼짐, LWIR_CAM_STAMP=1 이 같이 있어야 한다). 1 로 하면 그림을 64 KB 파이프로 열 번에 나눠 보내지 않고
# /dev/shm/lwir_cam_ring_<사용자 번호> (프레임 4 장, 약 2.4 MB)에 쓰고, 파이프로는 48 바이트 머리만 보낸다. 서버가 바빠도 카메라 프로그램이 기다리지 않는다.
# 서버가 늦어 덮어쓰인 프레임은 버리고 센다 (STAMP 60 s 줄의 ring dropped). 공유 메모리를 만들거나 열지 못하면 파이프로 보내고 기록에 남긴다.
#export LWIR_CAM_SHM=1

# ---- 시간 재기와 검출기에 넣는 방식 (2026-11-11, 둘 다 기본 꺼짐) ----
# 아래 변수도 서버가 직접 읽는다. 반드시 앞에 export 를 붙이고, 바꾼 뒤에는 서버를 다시 시작한다. 줄을 지우거나 # 을 붙이면 전과 똑같이 돈다.

# 단계별 시간 재기. 1 로 하면 프레임마다 "도착 → 검출기에 넣음 → 결과 받음 → 상자로 풂 → 추적 → 번호 잇기 → 내보냄" 시각을 적는다.
# 60초마다 한 줄 요약(STAGE 60 s)이 화면 출력과 camera_events.log 에 남는다. stage_timing.csv (마지막 3000 프레임)와 stage_timing_summary.json 은
# 서버가 스스로 끝날 때(--live-seconds)만 결과 폴더에 생긴다. 실시간 서버는 SIGTERM 으로 끄므로 생기지 않는다: 60초 줄을 보거나,
# 결과 폴더에 stage_timing.request 라는 빈 파일을 만들어 그때의 CSV 를 받는다.
# 정확히 1 일 때만 켜진다. 카메라 쪽 시각(cam)과 카메라 프레임 번호(cam_seq)까지 보려면 LWIR_CAM_STAMP=1 도 같이 켠다.
#export LWIR_STAGE_TIMING=1
# CSV 에 남길 프레임 수 (천 단위, 기본 3 = 3000 프레임).
#export LWIR_STAGE_TIMING_N=3

# 기본 실시간 실행에서는 다음 입력이 큐에 있을 때만 먼저 제출합니다.
# 큐가 비면 현재 결과를 발행한 뒤 입력을 기다립니다. 기존 방식으로 돌아가려면 0.
#export LWIR_LIVE_READY_PREFETCH=0

# 도착하는 대로 검출기에 넣기. arrival 로 하면 프레임이 도착하자마자 검출기에 넣는다 (같은 검출 모델을 NPU 코어 1 에 하나 더 올려 코어 0, 1 을 번갈아 쓴다).
# 프레임 반복이 느려서 두 코어가 다 차 있으면 기다리는 프레임 가운데 오래된 것을 버리고 센다 (/healthz 의 q_drop, 전과 같은 숫자).
# 켤 수 없는 경우(둘째 엔진을 못 만듦, --pipeline / --npu-depth 1 / --no-vit 가 아님 등)에는 "FEED arrival refused: ..." 한 줄을 찍고 전 방식으로 돈다.
# 장치에서는 아직 재지 않았다 (PC 의 가짜 NPU 로만 확인). 설명은 src/detect/frame_feed.py 맨 위에 있다.
# 장치에서 잰 결과 (2026-11-12, 실외 녹화 재생, 진짜 NPU, 180 초 x 3 번): 켜지 말 것.
#   초당 25 장: 도착->결과 중간값 72 -> 66 ms 로 줄지만 0.5 % 를 버린다 (보통 방식은 0). 초당 30 장: 63 -> 75 ms 로 느려지고 5 % 를 버린다.
#export LWIR_NPU_FEED=arrival
