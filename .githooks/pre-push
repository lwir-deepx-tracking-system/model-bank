#!/bin/sh
# 인수인계 규칙: push 하는 커밋들 안에서 HANDOFF.md 가 바뀌지 않았으면 push 를 막는다.
# 켜는 법 (저장소를 받은 곳에서 한 번): git config core.hooksPath .githooks
# 규칙 설명: HANDOFF.md 7절 "push 할 때", AGENTS.md
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                 # 가지 지우기
  if [ "$remote_sha" = "$zero" ]; then                     # 새 가지: 원격 main 과 갈라진 곳부터 본다
    base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null)
    [ -z "$base" ] && continue
    range="$base..$local_sha"
  else
    git cat-file -e "$remote_sha^{commit}" 2>/dev/null || { echo "pre-push: 원격의 최신 커밋을 몰라 검사할 수 없음. git fetch 뒤 다시 push 하세요." >&2; exit 1; }
    range="$remote_sha..$local_sha"
  fi
  [ -z "$(git rev-list "$range")" ] && continue
  if ! git diff --name-only "$range" -- HANDOFF.md | grep -q .; then
    echo "pre-push: 이번 push 에 HANDOFF.md 고침이 없습니다 ($remote_ref)." >&2
    echo "  HANDOFF.md 의 상태·다음 할 일을 고치고 8절에 한 줄을 더한 뒤 커밋하고 다시 push 하세요 (HANDOFF.md 7절)." >&2
    fail=1
  fi
done
exit $fail
